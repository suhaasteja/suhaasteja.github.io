---
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import Navbar from '../../components/Navbar.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Blog | Suhaas Teja</title>
		<meta name="description" content="Thoughts, tutorials, and updates from Suhaas Teja." />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-black text-white font-space min-h-screen flex flex-col">
        <Navbar />

		<main class="flex-grow w-full max-w-4xl mx-auto px-4 py-12 mt-16">
            <div class="mb-12">
                <h1 class="text-5xl md:text-6xl font-bold text-white mb-2 tracking-tighter">TRANSMISSIONS</h1>
                <p class="text-xl text-cyan-400 font-mono">>> SYSTEM_LOGS_ACCESSED</p>
            </div>
			<section>
				<ul class="grid gap-8 md:grid-cols-2">
					{
						posts.map((post) => (
							<li class="group">
								<a href={`/blog/${post.slug}/`} class="block h-full bg-gray-900/50 border border-gray-800 rounded-xl overflow-hidden hover:border-primary/50 hover:shadow-lg hover:shadow-primary/10 transition-all duration-300">
                                    <div class="p-6">
                                        <div class="text-sm text-gray-400 mb-2">
                                            <time datetime={post.data.pubDate.toISOString()}>
                                                {post.data.pubDate.toLocaleDateString('en-us', {
                                                    year: 'numeric',
                                                    month: 'short',
                                                    day: 'numeric',
                                                })}
                                            </time>
                                        </div>
                                        <h2 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors">{post.data.title}</h2>
                                        <p class="text-gray-400 line-clamp-3">{post.data.description}</p>
                                    </div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
        
        <footer class="text-center py-8 text-gray-500 text-sm">
            &copy; {new Date().getFullYear()} Suhaas Teja. All rights reserved.
        </footer>
	</body>
</html>
