---
import spotifyData from '../data/spotify.json';
const tracks = spotifyData;
---

<div class="spotify-card">
    <div class="header">
        <span class="icon">🎵</span>
        <h3>On Repeat</h3>
        <div class="equalizer">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </div>
    </div>
    
    <div class="tracks">
        {tracks.slice(0, 5).map((track: any) => (
            <a href={track.externalUrl} target="_blank" class="track">
                <img src={track.albumArtUrl} alt={track.title} />
                <div class="info">
                    <p class="title">{track.title}</p>
                    <p class="artist">{track.artist}</p>
                </div>
            </a>
        ))}
        {tracks.length === 0 && <p class="no-data">No listening data available.</p>}
    </div>
</div>

<style>
    .spotify-card {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    /* Removed hover effects as they are handled by HoloCard */    
    .header {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
        gap: 0.5rem;
    }
    
    .header h3 {
        color: var(--accent);
        font-size: 1.2rem;
        margin: 0;
    }
    
    .equalizer {
        display: flex;
        gap: 2px;
        height: 12px;
        align-items: flex-end;
        margin-left: auto;
    }
    
    .bar {
        width: 3px;
        background: var(--accent);
        animation: equalize 1s infinite;
    }
    
    .bar:nth-child(1) { animation-delay: 0.1s; height: 60%; }
    .bar:nth-child(2) { animation-delay: 0.3s; height: 100%; }
    .bar:nth-child(3) { animation-delay: 0.5s; height: 80%; }
    .bar:nth-child(4) { animation-delay: 0.2s; height: 40%; }
    
    @keyframes equalize {
        0%, 100% { height: 40%; }
        50% { height: 100%; }
    }
    
    .tracks {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    
    .track {
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        color: inherit;
        padding: 0.5rem;
        border-radius: 8px;
        transition: background 0.2s;
    }
    
    .track:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    
    .track img {
        width: 48px;
        height: 48px;
        border-radius: 4px;
    }
    
    .info {
        flex: 1;
        min-width: 0;
    }
    
    .title {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--text-primary);
    }
    
    .artist {
        font-size: 0.9rem;
        color: var(--text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .no-data {
        color: var(--text-secondary);
        font-style: italic;
    }
</style>
