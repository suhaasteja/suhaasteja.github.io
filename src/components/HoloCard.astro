---
interface Props {
    title?: string;
    class?: string;
}

const { title, class: className } = Astro.props;
---

<div class={`holo-card ${className || ''}`}>
    {title && <div class="card-header"><h3>{title}</h3></div>}
    <div class="card-content">
        <slot />
    </div>
    <div class="corner top-left"></div>
    <div class="corner top-right"></div>
    <div class="corner bottom-left"></div>
    <div class="corner bottom-right"></div>
</div>

<style>
    .holo-card {
        background: rgba(10, 10, 15, 0.4);
        border: 1px solid rgba(0, 243, 255, 0.1);
        backdrop-filter: blur(5px);
        padding: 1.5rem;
        position: relative;
        transition: all 0.3s ease;
        overflow: hidden;
    }

    .holo-card:hover {
        border-color: var(--neon-cyan);
        box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);
        transform: translateY(-2px);
    }

    .card-header h3 {
        color: var(--neon-cyan);
        margin-bottom: 1rem;
        font-size: 1.2rem;
        border-bottom: 1px solid rgba(0, 243, 255, 0.2);
        padding-bottom: 0.5rem;
        display: inline-block;
    }

    .corner {
        position: absolute;
        width: 10px;
        height: 10px;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

    .holo-card:hover .corner {
        border-color: var(--neon-purple);
    }

    .top-left { top: 0; left: 0; border-top-color: var(--neon-cyan); border-left-color: var(--neon-cyan); }
    .top-right { top: 0; right: 0; border-top-color: var(--neon-cyan); border-right-color: var(--neon-cyan); }
    .bottom-left { bottom: 0; left: 0; border-bottom-color: var(--neon-cyan); border-left-color: var(--neon-cyan); }
    .bottom-right { bottom: 0; right: 0; border-bottom-color: var(--neon-cyan); border-right-color: var(--neon-cyan); }
</style>
